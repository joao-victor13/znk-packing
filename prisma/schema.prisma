// Prisma Schema para Sistema de Gestão de Compras e Pedidos de Confecção (Moda Feminina)
// Banco de Dados: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS DE SISTEMA & REGRAS DE NEGÓCIO
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN               // Administrador Geral (Acesso Irrestrito)
  BUYER               // Comprador / Estilista (Criação e Edição de Pedidos)
  PRODUCTION_MANAGER  // Gerente de Produção / PCP (Aprovação e Acompanhamento de Prazos)
  FINANCE             // Financeiro (Auditoria de Custos e Faturamento)
  VIEWER              // Visualizador / Leitura Apenas
}

enum OrderStatus {
  DRAFT        // Rascunho (Não enviado ao fornecedor)
  PENDING      // Pendente (Enviado / Aguardando confirmação)
  APPROVED     // Aprovado (Em produção / Corte)
  IN_TRANSIT   // Em Trânsito (Despachado pela transportadora)
  DELIVERED    // Entregue / Faturado (Integrado ao estoque)
  CANCELLED    // Cancelado
}

enum AuditAction {
  USER_LOGIN_SUCCESS
  USER_LOGIN_FAILED
  USER_LOCKED
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_STATUS_CHANGED
  ORDER_DELETED
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  STORE_SETTINGS_UPDATED
  CATEGORY_MUTATED
}

// -----------------------------------------------------------------------------
// 1. CONFIGURAÇÕES GLOBAIS & IDENTIDADE DA MARCA (BRAND SETTINGS)
// -----------------------------------------------------------------------------

model StoreSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  brandName          String   @map("brand_name") @db.VarChar(100)
  brandSlogan        String?  @map("brand_slogan") @db.VarChar(200)
  legalName          String   @map("legal_name") @db.VarChar(150)
  cnpj               String   @unique @db.VarChar(18) // CNPJ formatado 00.000.000/0001-00
  purchasingEmail    String   @map("purchasing_email") @db.VarChar(120)
  whatsappBusiness   String   @map("whatsapp_business") @db.VarChar(20)
  phoneSecondary     String?  @map("phone_secondary") @db.VarChar(20)
  showroomAddress    String   @map("showroom_address") @db.VarChar(255)
  city               String   @db.VarChar(80)
  state              String   @db.Char(2)
  currencySymbol     String   @default("R$") @map("currency_symbol") @db.VarChar(5)
  legalFooterNotes   String?  @map("legal_footer_notes") @db.Text
  logoUrl            String?  @map("logo_url") @db.VarChar(500)
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Auditoria de quem alterou as configurações da loja
  updatedByUser      User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// 2. USUÁRIOS, SEGURANÇA E AUTENTICAÇÃO
// -----------------------------------------------------------------------------

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String         @db.VarChar(100)
  email                String         @unique @db.VarChar(120)
  passwordHash         String         @map("password_hash") @db.VarChar(255) // Argon2id hash
  role                 UserRole       @default(BUYER)
  roleTitle            String?        @map("role_title") @db.VarChar(80) // Ex: "Estilista Sênior"
  avatarUrl            String?        @map("avatar_url") @db.VarChar(500)
  isActive             Boolean        @default(true) @map("is_active")
  
  // Proteção contra Força Bruta & Bloqueio Temporário
  failedLoginAttempts  Int            @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?      @map("locked_until") @db.Timestamptz(6)
  lastLoginAt          DateTime?      @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp          String?        @map("last_login_ip") @db.VarChar(45)

  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relacionamentos
  refreshTokens        RefreshToken[]
  purchaseOrders       PurchaseOrder[]
  auditLogs            AuditLog[]
  storeSettingsUpdates StoreSettings[]

  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255) // Hash SHA-256 do token
  userAgent   String?   @map("user_agent") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  isRevoked   Boolean   @default(false) @map("is_revoked")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// 3. FORNECEDORES & OFICINAS DE CONFECÇÃO
// -----------------------------------------------------------------------------

model Supplier {
  id                   String          @id @default(uuid()) @db.Uuid
  corporateName        String          @map("corporate_name") @db.VarChar(150) // Razão Social
  tradeName            String          @map("trade_name") @db.VarChar(120)     // Nome Fantasia
  cnpjCpf              String          @unique @map("cnpj_cpf") @db.VarChar(18)
  contactName          String          @map("contact_name") @db.VarChar(100)   // Representante Comercial
  phone                String          @db.VarChar(20)
  whatsapp             String          @db.VarChar(20)
  email                String          @db.VarChar(120)
  city                 String          @db.VarChar(80)
  state                String          @db.Char(2)
  defaultPaymentTerms  String          @map("default_payment_terms") @db.VarChar(80)
  categorySpecialty    String          @map("category_specialty") @db.VarChar(120) // Ex: "Alfaiataria e Linho"
  averageLeadDays      Int             @default(18) @map("average_lead_days")
  rating               Decimal         @default(5.0) @db.Decimal(2, 1) // 1.0 a 5.0
  isActive             Boolean         @default(true) @map("is_active")
  notes                String?         @db.Text

  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relacionamentos
  purchaseOrders       PurchaseOrder[]

  @@index([cnpjCpf])
  @@index([tradeName])
  @@index([isActive])
  @@map("suppliers")
}

// -----------------------------------------------------------------------------
// 4. CATEGORIAS DE MODA FEMININA
// -----------------------------------------------------------------------------

model Category {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique @db.VarChar(60) // Ex: "Vestidos", "Alfaiataria"
  slug        String              @unique @db.VarChar(60)
  badgeBg     String              @default("bg-stone-100") @map("badge_bg") @db.VarChar(30)
  badgeText   String              @default("text-stone-800") @map("badge_text") @db.VarChar(30)
  badgeBorder String              @default("border-stone-200") @map("badge_border") @db.VarChar(30)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relacionamentos
  orderItems  PurchaseOrderItem[]

  @@index([slug])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// 5. PEDIDOS DE COMPRA (PURCHASE ORDERS) & ITENS
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  orderNumber          String              @unique @map("order_number") @db.VarChar(30) // Ex: "PED-2026-0042"
  supplierId           String              @map("supplier_id") @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  status               OrderStatus         @default(PENDING)
  collection           String              @db.VarChar(80) // Ex: "Alto Verão 2026"
  issueDate            DateTime            @map("issue_date") @db.Date
  expectedDeliveryDate DateTime            @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime?           @map("actual_delivery_date") @db.Date
  paymentTerms         String              @map("payment_terms") @db.VarChar(80)
  shippingCarrier      String?             @map("shipping_carrier") @db.VarChar(80)
  
  // Valores Financeiros (DECIMAL de Alta Precisão)
  shippingCost         Decimal             @default(0.00) @map("shipping_cost") @db.Decimal(10, 2)
  discount             Decimal             @default(0.00) @db.Decimal(10, 2)
  totalPieces          Int                 @default(0) @map("total_pieces")
  totalAmount          Decimal             @default(0.00) @map("total_amount") @db.Decimal(10, 2) // Subtotal + Frete - Desconto
  
  notes                String?             @db.Text
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relacionamentos
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                PurchaseOrderItem[]

  // Índices para otimização de consultas e relatórios
  @@index([orderNumber])
  @@index([supplierId])
  @@index([status])
  @@index([expectedDeliveryDate])
  @@index([issueDate])
  @@index([status, expectedDeliveryDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  
  sku             String        @db.VarChar(50) // Ref / Código da peça (ex: "VEST-2401")
  description     String        @db.VarChar(150)
  sizeGridType    String        @default("letter") @map("size_grid_type") @db.VarChar(20)
  size            String        @db.VarChar(50) // Ex: "Grade P/M/G", "38-44", "M"
  color           String        @db.VarChar(50) // Ex: "Terracota", "Off-White"
  colorHex        String?       @map("color_hex") @db.VarChar(7) // Ex: "#C2593F"
  
  quantity        Int           @db.Integer
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)
  suggestedPrice  Decimal?      @map("suggested_price") @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2) // quantity * unitCost
  notes           String?       @db.VarChar(255)
  
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relacionamentos
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([sku])
  @@index([categoryId])
  @@map("purchase_order_items")
}

// -----------------------------------------------------------------------------
// 6. LOGS DE AUDITORIA & RASTREABILIDADE (CYBER SECURITY COMPLIANCE)
// -----------------------------------------------------------------------------

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  action       AuditAction
  entityType   String      @map("entity_type") @db.VarChar(50) // Ex: "StoreSettings", "PurchaseOrder"
  entityId     String?     @map("entity_id") @db.VarChar(50)
  previousState Json?      @map("previous_state") @db.JsonB
  newState     Json?       @map("new_state") @db.JsonB
  ipAddress    String?     @map("ip_address") @db.VarChar(45)
  userAgent    String?     @map("user_agent") @db.VarChar(255)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

# ==============================================================================
# VARIÁVEIS DE AMBIENTE DE PRODUÇÃO - ZNK ATELIER ERP (ORACLE CLOUD)
# Copie este arquivo para .env.production e preencha com chaves fortes geradas via openssl
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMÍNIO & CONFIGURAÇÕES GERAIS
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://compras.znkatelier.com.br
DOMAIN_NAME=compras.znkatelier.com.br
LETSENCRYPT_EMAIL=admin@znkatelier.com.br

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS POSTGRESQL
# ------------------------------------------------------------------------------
POSTGRES_DB=znk_fashion_erp
POSTGRES_USER=znk_db_admin
# Gere uma senha segura com: openssl rand -base64 24
POSTGRES_PASSWORD=SUA_SENHA_POSTGRES_EXTREMAMENTE_SEGURA_AQUI

# ------------------------------------------------------------------------------
# 3. CHAVES CRIPTOGRÁFICAS & AUTENTICAÇÃO (CYBER SECURITY)
# Gere cada chave abaixo com o comando: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=SUA_CHAVE_JWT_SECRET_DE_48_BYTES_BASE64_AQUI
JWT_REFRESH_SECRET=SUA_CHAVE_JWT_REFRESH_SECRET_DE_48_BYTES_BASE64_AQUI
SESSION_COOKIE_SECRET=SUA_CHAVE_COOKIE_SECRET_DE_48_BYTES_BASE64_AQUI

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & REDIS (OPCIONAL / RECOMENDADO EM ALTO VOLUME)
# ------------------------------------------------------------------------------
REDIS_URL=
